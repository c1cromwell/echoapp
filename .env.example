# Echo App — Local Development Environment
# Copy to .env and adjust as needed. docker-compose.yml uses these defaults inline.

API_PORT=8000
ENVIRONMENT=development
# Set to true only if you need open /v1/phase1/* validate endpoints outside development (not recommended).
# PHASE1_ALLOW_OPEN_VALIDATE=false
# Accept Xcode-local StoreKit test transactions (ios/Echo/Configs/EchoVIP.storekit)
# on POST /v1/auth/vip-verify without verifying the Apple certificate chain.
# Ignored when ENVIRONMENT=production. Default: verify against Apple Root CA - G3.
# VIP_ALLOW_UNVERIFIED_STOREKIT=true
# Operator token for GET /v1/admin/safety/reports (Authorization: Bearer ...).
# At least 32 characters; when unset the route returns 404.
# ADMIN_API_TOKEN=
LOG_LEVEL=debug

# Reverse proxies in front of the API that append the client address to
# X-Forwarded-For (0 = none: the header is ignored and the socket address is
# used for per-IP rate limits). Set to the exact number of proxies you operate;
# a value that is too high lets clients spoof their address.
# TRUSTED_PROXY_HOPS=0

# PostgreSQL
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=echoapp
DATABASE_USER=echoapp
DATABASE_PASSWORD=echoapp_dev
DATABASE_SSLMODE=disable

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# NATS
NATS_URL=nats://localhost:4222

# Storage (MinIO S3-compatible)
STORAGE_BACKEND=s3
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_BUCKET=echo-media
STORAGE_ACCESS_KEY_ID=minioadmin
STORAGE_SECRET_ACCESS_KEY=minioadmin
STORAGE_FORCE_PATH_STYLE=true

# APNs (iOS push — optional for local dev)
# APNS_KEY_PATH=
# APNS_KEY_FILE=
# APNS_KEY_ID=
# APNS_TEAM_ID=
# APNS_BUNDLE_ID=com.echo.app
# APNS_ENVIRONMENT=sandbox

# Echo's own chain: a private Hyperledger Besu network (docs/BESU_MIGRATION_PLAN.md).
# `make dev` starts a local one and writes these values to deploy/besu/local/.network/chain.env.
# Leave BESU_RPC_URLS unset to run without a chain (anchoring is then off). If it is set, the
# contract address and IDENTITY_SERVICE_KEY_PEM must be valid or the server refuses to start.
# ECHO_CHAIN_NETWORK accepts only "besu"; it labels anchor proof bundles.
ECHO_CHAIN_NETWORK=besu
# BESU_RPC_URLS=http://localhost:8545,http://localhost:8546,http://localhost:8547,http://localhost:8548
# BESU_ANCHOR_CONTRACT=0x...
# For verifying proofs (cmd/verifyproof, make chain-test); the gateway itself does not need it.
# BESU_VALIDATORS=0x...,0x...,0x...,0x...
# Constellation-hosted Digital Evidence API. Off by default: the client is not
# constructed unless this is true AND DIGITAL_EVIDENCE_API_KEY is set.
DIGITAL_EVIDENCE_ENABLED=false
# DIGITAL_EVIDENCE_API_KEY=
# DIGITAL_EVIDENCE_ORG_ID=
# DIGITAL_EVIDENCE_TENANT_ID=

# Identity Service authorized sender (Phase 1: only this DID may submit
# updates to the Identity Metagraph). Generate with `cmd/didkey`.
# IDENTITY_SERVICE_DID=did:key:z...

# Per-environment cluster UUIDs (override defaults in
# metagraph/.../ClusterIds.scala). Generate with `uuidgen` for shared envs.
# IDENTITY_L0_CLUSTER_ID=
# IDENTITY_L1_CLUSTER_ID=
# METAGRAPH_L0_CLUSTER_ID=
# CURRENCY_L1_CLUSTER_ID=
# DATA_L1_CLUSTER_ID=

VIP_ALLOW_SANDBOX_STOREKIT=false   # accept Apple-signed Sandbox purchases (TestFlight / App Review)
