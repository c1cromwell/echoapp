# Echo App — Local Development Environment
# Copy to .env and adjust as needed. docker-compose.yml uses these defaults inline.

API_PORT=8000
ENVIRONMENT=development
LOG_LEVEL=debug

# PostgreSQL
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=echoapp
DATABASE_USER=echoapp
DATABASE_PASSWORD=echoapp_dev
DATABASE_SSLMODE=disable

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# NATS
NATS_URL=nats://localhost:4222

# Storage (MinIO S3-compatible)
STORAGE_BACKEND=s3
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_BUCKET=echo-media
STORAGE_ACCESS_KEY_ID=minioadmin
STORAGE_SECRET_ACCESS_KEY=minioadmin
STORAGE_FORCE_PATH_STYLE=true

# APNs (iOS push — optional for local dev)
# APNS_KEY_PATH=
# APNS_KEY_ID=
# APNS_TEAM_ID=
# APNS_BUNDLE_ID=com.echo.app
# APNS_ENVIRONMENT=sandbox

# Metagraph (Constellation Euclid SDK — Phase 1 local cluster)
# Global L0 (network-wide consensus)
# GLOBAL_L0_URL=http://localhost:9000
# Currency Metagraph L0 + L1
# METAGRAPH_L0_URL=http://localhost:9200
# CURRENCY_L1_URL=http://localhost:9300
# Data L1 (Merkle roots, trust commitments)
# DATA_L1_URL=http://localhost:9400
# Identity Metagraph L0 + L1 (VC issuance, trust tier commitments,
# StatusList2021 revocation, EchoOrgRoleCredential — see WO-272/WO-276)
# IDENTITY_L0_URL=http://localhost:9100
# IDENTITY_L1_URL=http://localhost:9500
# Identity Service authorized sender (Phase 1: only this DID may submit
# updates to the Identity Metagraph). Generate with `cmd/didkey`.
# IDENTITY_SERVICE_DID=did:key:z...

# Per-environment cluster UUIDs (override defaults in
# metagraph/.../ClusterIds.scala). Generate with `uuidgen` for shared envs.
# IDENTITY_L0_CLUSTER_ID=
# IDENTITY_L1_CLUSTER_ID=
# METAGRAPH_L0_CLUSTER_ID=
# CURRENCY_L1_CLUSTER_ID=
# DATA_L1_CLUSTER_ID=
