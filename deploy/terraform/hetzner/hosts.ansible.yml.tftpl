---
# GENERATED by terraform (deploy/terraform/hetzner/metagraph-nodes.tf). Do not edit by hand.
# Copy this to <euclid clone>/infra/ansible/remote/hosts.ansible.yml before `hydra remote-deploy`.
# See docs/ZERO_TO_PRODUCTION.md §4.
nodes:
  hosts:
%{ for i, ip in node_ips ~}
    node-${i + 1}:
      ansible_host: ${ip}
      ansible_user: ${ssh_user}
      ansible_ssh_private_key_file: ${ssh_key}
%{ endfor ~}
  vars:
    ansible_ssh_common_args: "-o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null"
    base_metagraph_l0_public_port: 9100
    base_metagraph_l0_p2p_port: 9101
    base_metagraph_l0_cli_port: 9102
    base_currency_l1_public_port: 9200
    base_currency_l1_p2p_port: 9201
    base_currency_l1_cli_port: 9202
    base_data_l1_public_port: 9300
    base_data_l1_p2p_port: 9301
    base_data_l1_cli_port: 9302

monitoring:
  hosts:
    monitoring-1:
      ansible_host: ${monitoring_ip}
      ansible_user: ${ssh_user}
      ansible_ssh_private_key_file: ${ssh_key}
  vars:
    ansible_ssh_common_args: "-o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null"
