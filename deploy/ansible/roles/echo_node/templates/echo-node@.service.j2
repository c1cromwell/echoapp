# One Echo chain layer per instance: echo-node@global-l0, echo-node@metagraph-l0, ...
[Unit]
Description=Echo chain node (%i)
After=network-online.target
Wants=network-online.target

[Service]
User={{ echo_user }}
Group={{ echo_user }}
EnvironmentFile={{ echo_etc }}/%i.env
ExecStart={{ echo_opt }}/bin/echo-node.sh
WorkingDirectory={{ echo_var }}
# always: the launcher stops a node whose join has stalled, and a JVM stopped by a signal must come back.
Restart=always
RestartSec=15
TimeoutStopSec=60
LimitNOFILE=65536
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
