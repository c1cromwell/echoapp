{# Environment for deploy/sovereign/node/echo-node.sh. Values are double-quoted for systemd. #}
{% set grp = groups[L.group] %}
{% set idx = grp.index(inventory_hostname) %}
ECHO_LAYER="{{ layer }}"
ECHO_ROLE="{{ 'lead' if is_lead else 'validator' }}"
ECHO_HOME="{{ layer_home }}"
ECHO_JAR="{{ echo_opt }}/jars/{{ layer }}.jar"
ECHO_TOOLS="{{ echo_opt }}/tools"
ECHO_IP="{{ chain_ip }}"
ECHO_SEEDLIST="{{ echo_etc }}/{{ 'gl0.seedlist' if L.kind == 'gl0' else 'mg.seedlist' }}"
ECHO_PRIORITY_SEEDLIST="{{ echo_etc }}/gl0.priority"
ECHO_PEERS="{% for h in grp if h != inventory_hostname %}{{ manifest.nodes[h] }}@{{ hostvars[h].chain_ip }}:{{ L.port }}:{{ L.port + 1 }} {% endfor %}"
ECHO_JAVA_OPTS="-Xms{{ echo_heap_min | default('512m') }} -Xmx{{ echo_heap_max | default(L.heap) }} -Dlogback.configurationFile={{ echo_etc }}/logback.xml"
CL_KEYSTORE="{{ echo_etc }}/keys/{{ inventory_hostname }}.p12"
CL_KEYALIAS="{{ inventory_hostname }}"
CL_PASSWORD="{{ key_passwords[inventory_hostname] }}"
CL_PUBLIC_HTTP_PORT="{{ L.port }}"
CL_P2P_HTTP_PORT="{{ L.port + 1 }}"
CL_CLI_HTTP_PORT="{{ L.port + 2 }}"
{% if L.genesis is defined and is_lead %}
ECHO_GENESIS="{{ echo_etc }}/{{ layer }}-genesis.csv"
{% endif %}
{% if with_owner %}
ECHO_OWNER_KEYSTORE="{{ echo_etc }}/keys/{{ L.owner }}.p12"
ECHO_OWNER_KEYALIAS="{{ L.owner }}"
ECHO_OWNER_PASSWORD="{{ key_passwords[L.owner] }}"
{% endif %}
{% if L.kind == 'gl0' and echo_rollback_hash is defined and inventory_hostname == echo_rollback_host %}
ECHO_ROLLBACK_HASH="{{ echo_rollback_hash }}"
{% endif %}
{% if L.kind != 'gl0' %}
{# Each metagraph host talks to the Global L0 node with the same position. #}
{% set g = groups['gl0'][idx % (groups['gl0'] | length)] %}
CL_GLOBAL_L0_PEER_HTTP_HOST="{{ hostvars[g].chain_ip }}"
CL_GLOBAL_L0_PEER_HTTP_PORT="{{ echo_layers['global-l0'].port }}"
CL_GLOBAL_L0_PEER_ID="{{ manifest.nodes[g] }}"
{% if metagraph_id is defined and metagraph_id %}
CL_L0_TOKEN_IDENTIFIER="{{ metagraph_id }}"
{% endif %}
{% endif %}
{% if L.kind == 'l1' %}
{# An L1 node uses the L0 of its own metagraph on its own host. #}
CL_L0_PEER_HTTP_HOST="{{ chain_ip }}"
CL_L0_PEER_HTTP_PORT="{{ echo_layers[L.l0].port }}"
CL_L0_PEER_ID="{{ manifest.nodes[inventory_hostname] }}"
{% endif %}
{% if layer in ['metagraph-l0', 'data-l1'] %}
DATA_AUTHORIZED_SIGNERS="{{ echo_gateway_signer }}"
{% endif %}
{% if layer in ['identity-l0', 'identity-l1'] %}
IDENTITY_SERVICE_PUBLIC_KEY_HEX="{{ echo_gateway_signer }}"
IDENTITY_SERVICE_DID="{{ echo_identity_service_did }}"
{% endif %}
