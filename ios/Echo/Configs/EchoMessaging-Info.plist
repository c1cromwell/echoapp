<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>ECHO_PRODUCT</key>
	<string>messaging</string>
	<key>NSFaceIDUsageDescription</key>
	<string>Echo uses Face ID to unlock the app, sign in to your account, and authorize sensitive actions. Your face is your key — it never leaves your device.</string>
	<key>NSCameraUsageDescription</key>
	<string>Echo uses the camera for video calls and to scan profile QR codes so you can add contacts.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Echo uses the microphone for voice and video calls.</string>
	<key>NSContactsUsageDescription</key>
	<string>Echo scans your contacts on your device to find friends who already use ECHO. Phone numbers are hashed before any server lookup — we never upload your address book.</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.echo.enrollment</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>echo-enroll</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.echo.app</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>echo</string>
			</array>
		</dict>
	</array>
	<key>API_URL</key>
	<string>$(API_URL)</string>
	<key>UIAppFonts</key>
	<array>
		<string>GeistMono-Regular.ttf</string>
		<string>GeistMono-Medium.ttf</string>
		<string>GeistMono-SemiBold.ttf</string>
		<string>GeistMono-Bold.ttf</string>
	</array>
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>Echo uses Bluetooth to send and relay messages directly to nearby people over an offline mesh, with no internet or servers.</string>
	<key>UIBackgroundModes</key>
	<array>
		<string>bluetooth-central</string>
		<string>bluetooth-peripheral</string>
		<string>fetch</string>
	</array>
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>com.echo.disappearing.purge</string>
		<string>com.echo.scheduled.send</string>
	</array>
</dict>
</plist>
