# --- Supabase (portal operator auth + org membership only; NEVER compliance PII) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY
# Service-role key is server-only (SCIM provisioning, admin reads). Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# --- Go Comply backend (system of record for all compliance data) ---
# The portal calls this server-side, scoped by orgDID. WO-250+ endpoints.
COMPLY_API_BASE_URL=http://localhost:8011
# Service credential the portal uses to call the Comply API on behalf of an authenticated operator.
COMPLY_API_SERVICE_TOKEN=dev-service-token

# --- SCIM provisioning (enterprise IdP -> portal seats) ---
# Bearer token the customer's IdP presents to the SCIM endpoints. Rotate per-tenant in production.
SCIM_BEARER_TOKEN=dev-scim-token
# Default org for IdP-driven provisioning when the SCIM payload has no org extension.
SCIM_DEFAULT_ORG_DID=did:key:z6MkYOUR-ORG-DID
SCIM_DEFAULT_ORG_NAME=Acme Corp

# --- Launch landing page (public marketing) ---
# Off by default. Flip to "true" only once the legal entity + domain + Privacy Policy/ToS are live.
# Gates the /join landing, /join/terms, /join/privacy, and the /api/waitlist endpoint.
LANDING_ENABLED=false
# Public base URL of the marketing site, used to build referral links (e.g. https://echo.app).
NEXT_PUBLIC_SITE_URL=https://example.com
# Optional JSON map of IdP group display names -> portal roles (owner|admin|compliance_officer|auditor|viewer).
# SCIM_GROUP_ROLE_MAP={"Echo-Comply-Admin":"admin"}
