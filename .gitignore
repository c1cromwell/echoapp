node_modules/
.pnp
.pnp.js

# Build outputs
build/
dist/
# ...but keep the backend Dockerfiles: docker-compose*.yml and the Backend Image
# workflow build from build/Dockerfile, so a clean clone needs them tracked.
!/build/
/build/*
!/build/Dockerfile
!/build/Dockerfile.comply
*.tsbuildinfo

