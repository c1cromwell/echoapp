ios/Pods/
ios/build/
ios/Echo/Libraries/*.xcframework/
ios/*.xcworkspace
ios/*.xcodeproj/project.xcworkspace
**/xcuserdata/
*.xcuserstate
*.ipa
*.dSYM.zip
*.dSYM

# Swift Package Manager
.build/
.swiftpm/
Package.resolved

